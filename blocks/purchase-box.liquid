{% doc %}
  Self-contained purchase area: variant selection (only when more than one
  variant exists), quantity, add-to-cart, gift messaging, and delivery
  messaging. Kept isolated so a future COD app can replace this one block
  without disturbing the rest of the product page (CLAUDE.md §9).

  @example
  {% content_for 'block', type: 'purchase-box', id: 'purchase-box' %}
{% enddoc %}

<div class="purchase-box" {{ block.shopify_attributes }}>
  {% form 'product', product, class: 'purchase-box__form' %}
    {% assign current_variant = product.selected_or_first_available_variant %}

    {% unless product.has_only_default_variant %}
      <label class="purchase-box__label" for="purchase-box-variant-{{ block.id }}">
        {{ 'general.variant' | t }}
      </label>
      <select class="purchase-box__select" name="id" id="purchase-box-variant-{{ block.id }}">
        {% for variant in product.variants %}
          <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %}>
            {{ variant.title }} — {{ variant.price | money }}
          </option>
        {% endfor %}
      </select>
    {% else %}
      <input type="hidden" name="id" value="{{ current_variant.id }}">
    {% endunless %}

    <div class="purchase-box__quantity">
      <label class="purchase-box__label" for="purchase-box-quantity-{{ block.id }}">
        {{ 'general.quantity' | t }}
      </label>
      <input type="number" name="quantity" id="purchase-box-quantity-{{ block.id }}" min="1" value="1">
    </div>

    <button type="submit" class="purchase-box__cta">
      {{ block.settings.cta_label }}
    </button>
  {% endform %}

  {% if block.settings.show_gift and block.settings.gift_text != blank %}
    <p class="purchase-box__gift">{{ 'general.gift_badge' | t }} — {{ block.settings.gift_text }}</p>
  {% endif %}

  {% if block.settings.delivery_text != blank %}
    <p class="purchase-box__delivery">{{ block.settings.delivery_text }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .purchase-box {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--sand);
    border-bottom: 1px solid var(--sand);
  }

  .purchase-box__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .purchase-box__label {
    display: block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    margin-bottom: var(--space-1);
  }

  .purchase-box__select,
  .purchase-box__quantity input {
    width: 100%;
    padding: var(--space-2);
    border: 1px solid var(--sand);
    background-color: var(--ivory);
    color: var(--ink);
  }

  .purchase-box__cta {
    display: inline-block;
    align-self: flex-start;
    padding: var(--space-2) var(--space-6);
    font: inherit;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    background-color: var(--ink);
    color: var(--ivory);
    border: none;
    border-radius: var(--radius-button);
    cursor: pointer;
    transition: background-color var(--transition-base);
  }

  .purchase-box__cta:hover {
    background-color: var(--ink-soft);
  }

  .purchase-box__gift,
  .purchase-box__delivery {
    font-size: 0.875rem;
    color: var(--ink-soft);
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.purchase_box",
  "settings": [
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "Complétez votre rituel"
    },
    {
      "type": "checkbox",
      "id": "show_gift",
      "label": "t:labels.show_gift",
      "default": true
    },
    {
      "type": "text",
      "id": "gift_text",
      "label": "t:labels.gift_text",
      "default": "Rouleau à boucler sans chaleur offert avec ce rituel."
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "t:labels.delivery_text",
      "default": "Livraison partout au Maroc."
    }
  ],
  "presets": [{ "name": "t:general.purchase_box" }]
}
{% endschema %}
