{% doc %}
  Renders one written review (author, star rating, body, date, optional
  verified-purchase badge and customer photo). Part of the hidden reviews
  architecture from CLAUDE.md §11 — no review content is ever fabricated as
  a default.

  @example
  {% content_for 'block', type: 'review-item', id: 'review-item-1' %}
{% enddoc %}

<div class="review-item" {{ block.shopify_attributes }}>
  <div class="review-item__rating" aria-label="{{ 'general.rating_label' | t: rating: block.settings.rating }}">
    {% for i in (1..5) %}
      <span aria-hidden="true">{% if i <= block.settings.rating %}★{% else %}☆{% endif %}</span>
    {% endfor %}
  </div>

  <div class="review-item__header">
    <span class="review-item__author">{{ block.settings.author }}</span>
    {% if block.settings.verified %}
      <span class="review-item__verified">{{ 'general.verified_badge' | t }}</span>
    {% endif %}
    {% if block.settings.date != blank %}
      <span class="review-item__date">{{ block.settings.date }}</span>
    {% endif %}
  </div>

  <div class="review-item__body">{{ block.settings.body }}</div>

  {% if block.settings.photo %}
    <div class="review-item__photo">
      {{ block.settings.photo | image_url: width: 400 | image_tag }}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .review-item {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--sand);
  }

  .review-item__rating {
    color: var(--ink);
    letter-spacing: 0.1em;
  }

  .review-item__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .review-item__author {
    font-weight: 500;
  }

  .review-item__verified,
  .review-item__date {
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .review-item__body {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  .review-item__photo {
    margin-top: var(--space-2);
    width: 6rem;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .review-item__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.review_item",
  "settings": [
    {
      "type": "text",
      "id": "author",
      "label": "t:labels.author"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "t:labels.rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.body"
    },
    {
      "type": "text",
      "id": "date",
      "label": "t:labels.date"
    },
    {
      "type": "checkbox",
      "id": "verified",
      "label": "t:labels.verified",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "t:labels.photo"
    }
  ],
  "presets": [{ "name": "t:general.review_item" }]
}
{% endschema %}
