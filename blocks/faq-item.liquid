{% doc %}
  Renders one FAQ row as a native <details>/<summary> disclosure — no JS
  required for open/close, fully keyboard accessible by default.

  @example
  {% content_for 'block', type: 'faq-item', id: 'faq-item-1' %}
{% enddoc %}

<details class="faq-item" {{ block.shopify_attributes }}>
  <summary class="faq-item__question">{{ block.settings.question }}</summary>
  <div class="faq-item__answer">{{ block.settings.answer }}</div>
</details>

{% stylesheet %}
  .faq-item {
    border-bottom: 1px solid var(--sand);
    padding: var(--space-3) 0;
  }

  .faq-item__question {
    cursor: pointer;
    font-weight: 500;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__question::after {
    content: '+';
    flex-shrink: 0;
    color: var(--ink-soft);
  }

  details[open] > .faq-item__question::after {
    content: '−';
  }

  .faq-item__answer {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  .faq-item__answer p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq_item",
  "settings": [
    {
      "type": "text",
      "id": "question",
      "label": "t:labels.question",
      "default": "Question"
    },
    {
      "type": "richtext",
      "id": "answer",
      "label": "t:labels.answer"
    }
  ],
  "presets": [{ "name": "t:general.faq_item" }]
}
{% endschema %}
