{% doc %}
  Renders one typography-led benefit card (heading + short body copy, no
  icon) for the "Why satin" section.

  @example
  {% content_for 'block', type: 'benefit-item', id: 'benefit-item-1' %}
{% enddoc %}

<div class="benefit-item" {{ block.shopify_attributes }}>
  <h3 class="benefit-item__heading">{{ block.settings.heading }}</h3>
  <div class="benefit-item__body">{{ block.settings.body }}</div>
</div>

{% stylesheet %}
  .benefit-item__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
  }

  .benefit-item__body {
    color: var(--ink-soft);
  }

  .benefit-item__body p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.benefit_item",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Titre"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.body"
    }
  ],
  "presets": [{ "name": "t:general.benefit_item" }]
}
{% endschema %}
