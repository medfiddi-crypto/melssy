# Runtime environment name; use production in EasyPanel.
ENVIRONMENT=production
# EasyPanel PostgreSQL URL for the melssybeauty database; placeholder only.
DATABASE_URL=postgresql://USER: PASSWORD@HOST:5432/melssybeauty?sslmode=disable
# Sole browser origin permitted to call this API.
CORS_ORIGINS=https://melssy.beauty
# Deployed Google Apps Script endpoint; placeholder only.
ORDER_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE/exec
# Shared HMAC signing secret for the Apps Script webhook; placeholder only.
ORDER_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Enable one-way Google Sheets fulfillment delivery after configuring the webhook values.
ORDER_WEBHOOK_ENABLED=false
ORDER_WEBHOOK_TIMEOUT_SECONDS=10
ORDER_WEBHOOK_MAX_ATTEMPTS=5
ORDER_WEBHOOK_RETRY_INTERVAL_SECONDS=60
# Meta Pixel identifier used only by server-side CAPI; placeholder only.
META_PIXEL_ID=REPLACE_WITH_META_PIXEL_ID
# Meta Conversions API token; placeholder only.
META_CAPI_ACCESS_TOKEN=REPLACE_WITH_META_CAPI_ACCESS_TOKEN
# TikTok Pixel identifier used only by server-side Events API; placeholder only.
TIKTOK_PIXEL_ID=REPLACE_WITH_TIKTOK_PIXEL_ID
# TikTok Events API access token; placeholder only.
TIKTOK_EVENTS_API_ACCESS_TOKEN=REPLACE_WITH_TIKTOK_EVENTS_API_ACCESS_TOKEN
# Optional provider test-event code; leave blank outside testing.
TRACKING_TEST_EVENT_CODE=
# Shipping is free for the Beauty Night Ritual. Set the standalone-order threshold as needed.
STANDARD_SHIPPING_FEE=35.00
FREE_SHIPPING_THRESHOLD=0.00
