<footer>
  <div class="footer__top">
    <p class="wordmark">{{ shop.name }}</p>
    {% if section.settings.tagline != blank %}
      <p class="footer__tagline">{{ section.settings.tagline }}</p>
    {% endif %}
  </div>

  <div class="footer__bottom">
    <div class="footer__copyright">
      &copy;
      {{ 'now' | date: '%Y' }}
      {{ shop.name | link_to: routes.root_url }}, {{ powered_by_link }}
    </div>

    <div class="footer__links">
      {% for link in section.settings.menu.links %}
        {{ link.title | link_to: link.url }}
      {% endfor %}
    </div>

    <div class="footer__social">
      {% content_for 'blocks' %}
    </div>

    <div class="footer__payment">
      {% if section.settings.show_payment_icons %}
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--page-margin);
    margin-top: var(--space-6);
    border-top: 1px solid var(--sand);
    background-color: var(--night);
    color: var(--white);
  }

  footer .wordmark {
    color: var(--white);
    margin: 0;
  }

  footer .footer__tagline {
    margin: var(--space-1) 0 0;
    color: var(--sand);
    font-size: 0.875rem;
  }

  footer .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }

  footer a {
    text-decoration: none;
    color: var(--white);
  }

  footer .footer__links,
  footer .footer__social,
  footer .footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  footer .footer__copyright {
    color: var(--sand);
    font-size: 0.875rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "blocks": [{ "type": "social-link" }],
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "t:labels.tagline",
      "default": "MELSSY — Beauty while you sleep."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
