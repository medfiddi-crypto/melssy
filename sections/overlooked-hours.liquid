{% comment %}
  "The overlooked hours" — an editorial sequence of story-moment blocks,
  verbatim excerpts from the CLAUDE.md §5 brand story (never the full story
  dumped as one block, per §5). Generous vertical gap between blocks so the
  section feels unhurried.
{% endcomment %}

<div class="overlooked-hours full-width">
  <div class="overlooked-hours__content">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .overlooked-hours {
    background-color: var(--cream);
  }

  .overlooked-hours__content {
    display: grid;
    grid-template-columns: var(--content-grid);
    row-gap: var(--space-7);
    align-content: center;
    padding: var(--space-6) 0;
  }

  @media (min-width: 750px) {
    .overlooked-hours__content {
      padding: var(--space-7) 0;
    }
  }

  .overlooked-hours__content > * {
    grid-column: 2;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.overlooked_hours",
  "blocks": [{ "type": "story-moment" }],
  "presets": [{ "name": "t:general.overlooked_hours" }]
}
{% endschema %}
