<header>
  <div class="header__nav">
    {% if section.settings.menu.links.size > 0 %}
      <nav class="header__menu" aria-label="{{ 'general.menu' | t }}">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>

      <details class="header__mobile-menu">
        <summary class="header__mobile-menu-toggle" aria-label="{{ 'general.menu' | t }}">
          {{ 'icon-menu.svg' | inline_asset_content }}
        </summary>
        <nav class="header__mobile-menu-panel" aria-label="{{ 'general.menu' | t }}">
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        </nav>
      </details>
    {% endif %}
  </div>

  <h2 class="header__title">
    <a href="{{ routes.root_url }}">
      {% render 'wordmark',
        logo: section.settings.logo,
        show_tagline: section.settings.show_tagline,
        scale: section.settings.wordmark_scale
      %}
    </a>
  </h2>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  header {
    min-height: 5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-3);
  }

  header a {
    position: relative;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }

  header svg {
    width: 2rem;
  }

  .header__nav {
    justify-self: start;
  }

  .header__icons {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header__menu {
    display: none;
    align-items: center;
    gap: var(--space-4);
  }

  .header__menu a {
    color: var(--ink);
  }

  .header__mobile-menu {
    position: relative;
  }

  .header__mobile-menu-toggle {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
  }

  .header__mobile-menu-toggle::-webkit-details-marker {
    display: none;
  }

  .header__mobile-menu-panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    min-width: 12rem;
    padding: var(--space-4);
    background-color: var(--white);
    border: 1px solid var(--sand);
  }

  @media (min-width: 750px) {
    .header__menu {
      display: flex;
    }

    .header__mobile-menu {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "checkbox",
      "id": "show_tagline",
      "label": "t:labels.show_tagline",
      "default": true
    },
    {
      "type": "range",
      "id": "wordmark_scale",
      "label": "t:labels.wordmark_scale",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
