{% comment %}
  Homepage hero: full-width image (3:2 desktop / 4:5 mobile), headline, and
  a single CTA. Falls back to a plain token-coloured placeholder box, sized
  to the same ratios, when no image has been picked yet. At least 70vh tall,
  content vertically centered, image beside the content on desktop and
  above it on mobile. On mobile the image is additionally capped at 45vh so
  the headline and CTA stay visible above the fold.
{% endcomment %}

<div class="hero full-width" id="hero">
  <div class="hero__media">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high' }}
    {% else %}
      <div class="hero__media-placeholder"></div>
    {% endif %}
  </div>

  <div class="hero__content">
    <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% if section.settings.cta_label != blank %}
      <a class="hero__cta" href="{{ section.settings.link | default: '#the-product' }}">
        {{ section.settings.cta_label }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .hero {
    min-height: 70vh;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .hero__media {
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 45vh;
    overflow: hidden;
    background-color: var(--sand);
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__media-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--sand);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-6) var(--page-margin);
  }

  .hero__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.75rem;
    line-height: 1.15;
    letter-spacing: 0.02em;
    max-width: 32ch;
    margin: 0 0 var(--space-4);
  }

  .hero__cta {
    display: inline-block;
    align-self: center;
    width: fit-content;
    padding: var(--space-2) var(--space-6);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    background-color: var(--ink);
    color: var(--ivory);
    text-decoration: none;
    border-radius: var(--radius-button);
    transition: background-color var(--transition-base);
  }

  .hero__cta:hover {
    background-color: var(--ink-soft);
  }

  @media (min-width: 750px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
    }

    .hero__media {
      aspect-ratio: 3 / 2;
      max-height: none;
    }

    .hero__content {
      padding: var(--space-7) var(--space-6);
    }

    .hero__heading {
      font-size: clamp(2rem, 4vw, 3rem);
      line-height: 1.1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Votre routine beauté ne s'arrête pas quand vous fermez les yeux."
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "Découvrir le Rituel"
    }
  ],
  "presets": [{ "name": "t:general.hero" }]
}
{% endschema %}
