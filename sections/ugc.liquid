{% comment %}
  UGC gallery — hidden architecture per CLAUDE.md §11. Ships with zero
  default blocks; a merchant adds real creator content via "Add block" and
  flips this section's visibility on once it exists.
{% endcomment %}

<div class="ugc full-width">
  <div class="ugc__content">
    {% if section.settings.heading != blank %}
      <h2 class="ugc__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="ugc__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .ugc__content {
    display: grid;
    grid-template-columns: var(--content-grid);
    align-content: center;
    padding: var(--space-6) 0;
  }

  @media (min-width: 750px) {
    .ugc__content {
      padding: var(--space-7) 0;
    }
  }

  .ugc__content > * {
    grid-column: 2;
  }

  .ugc__heading {
    text-align: center;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.75rem;
    margin-bottom: var(--space-6);
  }

  .ugc__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 750px) {
    .ugc__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.ugc",
  "blocks": [{ "type": "ugc-item" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "presets": [{ "name": "t:general.ugc" }]
}
{% endschema %}
