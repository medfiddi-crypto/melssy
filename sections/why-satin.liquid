{% comment %}
  "Why satin" — three typography-led functional benefits. Heading is the
  approved copy recorded in CLAUDE.md §7. No icons, per §19.
{% endcomment %}

<div class="why-satin full-width">
  <div class="why-satin__content">
    {% if section.settings.heading != blank %}
      <h2 class="why-satin__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="why-satin__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .why-satin__content {
    display: grid;
    grid-template-columns: var(--content-grid);
    align-content: center;
    padding: var(--space-6) 0;
  }

  @media (min-width: 750px) {
    .why-satin__content {
      padding: var(--space-7) 0;
    }
  }

  .why-satin__content > * {
    grid-column: 2;
  }

  .why-satin__heading {
    text-align: center;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.75rem;
    margin-bottom: var(--space-6);
  }

  .why-satin__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
    max-width: 64rem;
    margin: 0 auto;
  }

  @media (min-width: 750px) {
    .why-satin__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.why_satin",
  "blocks": [{ "type": "benefit-item" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Pensé pour vos cheveux"
    }
  ],
  "presets": [
    {
      "name": "t:general.why_satin",
      "blocks": [
        { "type": "benefit-item", "settings": { "heading": "MOINS DE FROTTEMENTS", "body": "<p>Limite les frottements entre les cheveux et le tissu pendant la nuit.</p>" } },
        { "type": "benefit-item", "settings": { "heading": "RÉVEILLEZ-VOUS PRÊTE", "body": "<p>Aide à préserver votre coiffure pendant la nuit, pour un réveil plus doux.</p>" } },
        { "type": "benefit-item", "settings": { "heading": "VOTRE RITUEL DU SOIR", "body": "<p>Parce que prendre soin de ses cheveux ne devrait pas s'arrêter à 23h.</p>" } }
      ]
    }
  ]
}
{% endschema %}
