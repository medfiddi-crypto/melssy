{% comment %}
  Cart page: product, variant, quantity, price, subtotal, complimentary gift
  and delivery messaging, and the checkout CTA (CLAUDE.md §9).
{% endcomment %}

<div class="cart-page">
  <h1 class="cart-page__title">{{ 'cart.title' | t }}</h1>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page__form">
      <table class="cart-page__table">
        <thead>
          <tr>
            <th class="cart-page__cell cart-page__cell--product" scope="col">
              <span class="visually-hidden">{{ 'general.product' | t }}</span>
            </th>
            <th class="cart-page__cell cart-page__cell--quantity" scope="col">{{ 'general.quantity' | t }}</th>
            <th class="cart-page__cell cart-page__cell--price cart-page__cell--right" scope="col">{{ 'general.price' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr class="cart-page__row">
              <td class="cart-page__cell">
                <div class="cart-page__product">
                  {% render 'image',
                    image: item.image,
                    url: item.url,
                    width: 160,
                    height: 160,
                    crop: 'center'
                  %}
                  <div class="cart-page__product-info">
                    <a class="cart-page__product-title" href="{{ item.url }}">{{ item.product.title }}</a>
                    {% unless item.variant.title == 'Default Title' %}
                      <p class="cart-page__variant">{{ item.variant.title }}</p>
                    {% endunless %}
                    <a class="cart-page__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                  </div>
                </div>
              </td>
              <td class="cart-page__cell cart-page__cell--quantity">
                <input
                  class="cart-page__quantity"
                  type="number"
                  name="updates[{{ item.key }}]"
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="{{ 'general.quantity' | t }}"
                >
              </td>
              <td class="cart-page__cell cart-page__cell--price cart-page__cell--right">
                {{ item.final_line_price | money }}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      {% if section.settings.show_gift and section.settings.gift_text != blank %}
        <p class="cart-page__gift">{{ 'general.gift_badge' | t }} — {{ section.settings.gift_text }}</p>
      {% endif %}

      {% if section.settings.delivery_text != blank %}
        <p class="cart-page__delivery">{{ section.settings.delivery_text }}</p>
      {% endif %}

      <div class="cart-page__summary">
        <p class="cart-page__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </p>

        <div class="cart-page__actions">
          <button type="submit" name="update" class="cart-page__update">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="cart-page__checkout">{{ section.settings.checkout_label }}</button>
        </div>
      </div>
    </form>
  {% else %}
    <p class="cart-page__empty">{{ 'cart.empty' | t }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .cart-page {
    padding: var(--space-6) 0;
  }

  @media (min-width: 750px) {
    .cart-page {
      padding: var(--space-7) 0;
    }
  }

  .cart-page__title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: var(--space-5);
  }

  .cart-page__table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }

  .cart-page__cell {
    text-align: left;
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--sand);
    vertical-align: top;
  }

  .cart-page__cell--right {
    text-align: right;
  }

  .cart-page__cell--quantity {
    width: 4.5rem;
  }

  .cart-page__cell--price {
    width: 5.5rem;
  }

  thead .cart-page__cell {
    font-size: 0.875rem;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .cart-page__product {
    display: flex;
    gap: var(--space-3);
  }

  .cart-page__product .image {
    width: 5rem;
    flex-shrink: 0;
    aspect-ratio: 1 / 1;
  }

  .cart-page__product .image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 750px) {
    .cart-page__product .image {
      width: 6.25rem;
    }
  }

  .cart-page__product-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .cart-page__product-title {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }

  .cart-page__variant {
    color: var(--ink-soft);
    font-size: 0.875rem;
    margin: 0;
  }

  .cart-page__remove {
    color: var(--ink-soft);
    font-size: 0.875rem;
    width: fit-content;
  }

  .cart-page__quantity {
    width: 4rem;
    padding: var(--space-2);
    border: 1px solid var(--sand);
    background-color: var(--ivory);
    color: var(--ink);
    font: inherit;
  }

  .cart-page__gift,
  .cart-page__delivery {
    margin-top: var(--space-3);
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .cart-page__summary {
    margin-top: var(--space-5);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-3);
  }

  .cart-page__subtotal {
    display: flex;
    gap: var(--space-4);
    font-size: 1.125rem;
  }

  .cart-page__actions {
    display: flex;
    gap: var(--space-3);
  }

  .cart-page__update,
  .cart-page__checkout {
    display: inline-block;
    padding: var(--space-2) var(--space-6);
    font: inherit;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    border-radius: var(--radius-button);
    cursor: pointer;
    transition: background-color var(--transition-base);
  }

  .cart-page__update {
    background-color: var(--white);
    color: var(--ink);
    border: 1px solid var(--sand);
  }

  .cart-page__update:hover {
    background-color: var(--cream);
  }

  .cart-page__checkout {
    background-color: var(--ink);
    color: var(--ivory);
    border: none;
  }

  .cart-page__checkout:hover {
    background-color: var(--ink-soft);
  }

  .cart-page__empty {
    color: var(--ink-soft);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "text",
      "id": "checkout_label",
      "label": "t:labels.cta_label",
      "default": "Complétez votre rituel"
    },
    {
      "type": "checkbox",
      "id": "show_gift",
      "label": "t:labels.show_gift",
      "default": true
    },
    {
      "type": "text",
      "id": "gift_text",
      "label": "t:labels.gift_text",
      "default": "Rouleau à boucler sans chaleur offert avec ce rituel."
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "t:labels.delivery_text",
      "default": "Livraison partout au Maroc."
    }
  ]
}
{% endschema %}
