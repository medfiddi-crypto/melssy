{% comment %}
  "The product" — signature name, price (always dynamic from the referenced
  product, never hardcoded), what's-in-the-box list, and a CTA to the
  product page. Purely a summary/teaser: variant selection and add-to-cart
  belong to the product page itself (CLAUDE.md §8-9), not this section.
{% endcomment %}

<div class="the-product full-width" id="the-product">
  <div class="the-product__content">
    {% if section.settings.heading != blank %}
      <h2 class="the-product__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.tagline != blank %}
      <p class="the-product__tagline">{{ section.settings.tagline }}</p>
    {% endif %}

    {% if section.settings.product %}
      <p class="the-product__price">{{ section.settings.product.price | money }}</p>
    {% endif %}

    <div class="the-product__box-list">
      {% content_for 'blocks' %}
    </div>

    {% if section.settings.product and section.settings.cta_label != blank %}
      <a class="the-product__cta" href="{{ section.settings.product.url }}">
        {{ section.settings.cta_label }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .the-product__content {
    display: grid;
    grid-template-columns: var(--content-grid);
    align-content: center;
    padding: var(--space-6) 0;
    text-align: center;
  }

  @media (min-width: 750px) {
    .the-product__content {
      padding: var(--space-7) 0;
    }
  }

  .the-product__content > * {
    grid-column: 2;
  }

  .the-product__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.06em;
    font-size: 1.5rem;
  }

  .the-product__tagline {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  .the-product__price {
    margin-top: var(--space-4);
    font-size: 1.5rem;
  }

  .the-product__box-list {
    margin: var(--space-5) auto 0;
    max-width: 40ch;
    text-align: left;
  }

  .the-product__cta {
    display: inline-block;
    justify-self: center;
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-6);
    background-color: var(--ink);
    color: var(--ivory);
    text-decoration: none;
    border-radius: var(--radius-button);
    transition: background-color var(--transition-base);
  }

  .the-product__cta:hover {
    background-color: var(--ink-soft);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.the_product",
  "blocks": [{ "type": "box-item" }],
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "THE BEAUTY NIGHT RITUAL™"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "t:labels.tagline",
      "default": "MELSSY — Beauty while you sleep."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "Découvrir le Rituel"
    }
  ],
  "presets": [
    {
      "name": "t:general.the_product",
      "blocks": [
        { "type": "box-item", "settings": { "label": "2 taies d'oreiller en satin", "detail": "70 × 50 cm, fermeture zippée" } },
        { "type": "box-item", "settings": { "label": "1 bonnet en satin", "detail": "Environ 30 cm, ouverture élastiquée" } },
        { "type": "box-item", "settings": { "label": "2 chouchous en satin" } },
        { "type": "box-item", "settings": { "label": "1 rouleau à boucler sans chaleur", "detail": "Offert avec votre rituel", "is_gift": true } }
      ]
    }
  ]
}
{% endschema %}
