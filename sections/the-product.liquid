{% comment %}
  "The product" — bundle reveal image, a short bridge line (styled like the
  overlooked-hours quote blocks), signature name, price (always dynamic from
  the referenced product, never hardcoded), what's-in-the-box list, and a
  CTA to the product page. Purely a summary/teaser: variant selection and
  add-to-cart belong to the product page itself (CLAUDE.md §8-9), not this
  section.
{% endcomment %}

{% liquid
  assign bridge_font = settings.type_heading_font | font_modify: 'weight', '300' | default: settings.type_heading_font
%}

{% style %}
  {{ bridge_font | font_face: font_display: 'swap' }}
{% endstyle %}

<div class="the-product full-width" id="the-product" style="--the-product-bridge-weight: {{ bridge_font.weight }};">
  <div class="the-product__content">
    <div class="the-product__media">
      {% render 'image', image: section.settings.image, class: 'the-product__image', width: 1000 %}
    </div>

    {% if section.settings.bridge_text != blank %}
      <p class="the-product__bridge">{{ section.settings.bridge_text }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="the-product__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.tagline != blank %}
      <p class="the-product__tagline">{{ section.settings.tagline }}</p>
    {% endif %}

    {% if section.settings.product %}
      <p class="the-product__price">{{ section.settings.product.price | money }}</p>
    {% endif %}

    <div class="the-product__box-list">
      {% content_for 'blocks' %}
    </div>

    {% if section.settings.product and section.settings.cta_label != blank %}
      <a class="the-product__cta" href="{{ section.settings.product.url }}">
        {{ section.settings.cta_label }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .the-product__content {
    display: grid;
    grid-template-columns: var(--content-grid);
    align-content: center;
    padding: var(--space-6) 0;
    text-align: center;
  }

  @media (min-width: 750px) {
    .the-product__content {
      padding: var(--space-7) 0;
    }
  }

  .the-product__content > * {
    grid-column: 2;
  }

  .the-product__media {
    max-width: 28rem;
    margin: 0 auto var(--space-5);
  }

  .the-product__media .image {
    aspect-ratio: 4 / 5;
  }

  .the-product__media .image img {
    height: 100%;
    object-fit: cover;
  }

  .the-product__bridge {
    font-family: var(--font-heading--family);
    font-weight: var(--the-product-bridge-weight);
    font-size: 1.375rem;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  @media (min-width: 750px) {
    .the-product__bridge {
      font-size: 1.75rem;
    }
  }

  .the-product__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.06em;
    font-size: 1.5rem;
  }

  .the-product__tagline {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  .the-product__price {
    margin-top: var(--space-4);
    font-size: 1.5rem;
  }

  .the-product__box-list {
    margin: var(--space-5) auto 0;
    max-width: 40ch;
    text-align: left;
  }

  .the-product__cta {
    display: inline-block;
    justify-self: center;
    margin-top: var(--space-5);
    padding: var(--space-2) var(--space-6);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    background-color: var(--ink);
    color: var(--ivory);
    text-decoration: none;
    border-radius: var(--radius-button);
    transition: background-color var(--transition-base);
  }

  .the-product__cta:hover {
    background-color: var(--ink-soft);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.the_product",
  "blocks": [{ "type": "box-item" }],
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "bridge_text",
      "label": "t:labels.bridge_text",
      "default": "Voici votre rituel."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "THE BEAUTY NIGHT RITUAL™"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "t:labels.tagline",
      "default": "MELSSY — Beauty while you sleep."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "Découvrir le Rituel"
    }
  ],
  "presets": [
    {
      "name": "t:general.the_product",
      "blocks": [
        { "type": "box-item", "settings": { "label": "2 taies d'oreiller en satin", "detail": "70 × 50 cm, fermeture zippée" } },
        { "type": "box-item", "settings": { "label": "1 bonnet en satin", "detail": "Environ 30 cm, ouverture élastiquée" } },
        { "type": "box-item", "settings": { "label": "2 chouchous en satin" } },
        { "type": "box-item", "settings": { "label": "1 rouleau à boucler sans chaleur", "detail": "Offert avec votre rituel", "is_gift": true } }
      ]
    }
  ]
}
{% endschema %}
