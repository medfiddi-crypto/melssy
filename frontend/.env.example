# Canonical public storefront URL used for metadata and browser events.
NEXT_PUBLIC_SITE_URL=https://melssy.beauty
# Public URL of the MELSSY order API.
NEXT_PUBLIC_API_URL=https://api.melssy.beauty
# Meta browser Pixel ID; placeholder only, never an access token.
NEXT_PUBLIC_META_PIXEL_ID=REPLACE_WITH_META_PIXEL_ID
# TikTok browser Pixel ID; placeholder only, never an access token.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=REPLACE_WITH_TIKTOK_PIXEL_ID
# Moroccan WhatsApp number in international digits only, for example 2126XXXXXXXX.
NEXT_PUBLIC_WHATSAPP_NUMBER=REPLACE_WITH_WHATSAPP_NUMBER
# Morocco phone number customers should save for the confirmation call.
NEXT_PUBLIC_CONFIRMATION_PHONE=REPLACE_WITH_CONFIRMATION_PHONE
# Customer-facing confirmation time window.
NEXT_PUBLIC_CONFIRMATION_WINDOW=24 h
# Customer-facing dispatch time window.
NEXT_PUBLIC_DISPATCH_WINDOW=24 h
# Customer-facing delivery time window.
NEXT_PUBLIC_DELIVERY_WINDOW=2-4 jours
# Standard fee absorbed for Beauty Night Ritual orders, in MAD.
NEXT_PUBLIC_STANDARD_SHIPPING_FEE=35
# Free item included in the Beauty Night Ritual bundle.
NEXT_PUBLIC_FREE_GIFT_NAME=Boucleur sans chaleur
